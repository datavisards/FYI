{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["../src/*"]
    },
    "types": ["chrome"]
  },
  "include": ["./**/*.ts", "./**/*.tsx", "./**/*.d.ts", "../src/**/*.ts", "../src/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
